# Copy this file to .env.local for local `vercel dev` testing, and set the same
# keys as encrypted Environment Variables in the Vercel project dashboard for
# production. Never commit a file containing real values.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=gemini-2.0-flash

# Optional — where Hermes retrieves syllabus/topic content from. Defaults to
# this repo's own docs/syllabus folder on the main branch.
GITHUB_OWNER=MalathiKarunakaran
GITHUB_REPO=Student_Quiz_App
GITHUB_BRANCH=main

# Optional — safety cap on how many questions can be requested in one call.
MAX_QUESTIONS_PER_REQUEST=40

# Optional — how many times to retry the LLM call if it returns malformed JSON.
LLM_MAX_RETRIES=2
