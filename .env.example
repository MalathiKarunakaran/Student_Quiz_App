# Copy this file to .env.local for local `vercel dev` testing, and set the same
# keys as encrypted Environment Variables in the Vercel project dashboard for
# production. Never commit a file containing real values.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=gemini-2.0-flash

# Optional — where Hermes retrieves syllabus/topic content from. Defaults to
# this repo's own docs/syllabus folder on the main branch.
GITHUB_OWNER=MalathiKarunakaran
GITHUB_REPO=Student_Quiz_App
GITHUB_BRANCH=main

# Optional — safety cap on how many questions can be requested in one call.
MAX_QUESTIONS_PER_REQUEST=40

# Optional — how many times to retry the LLM call if it returns malformed JSON.
LLM_MAX_RETRIES=2

# --- Keyword-bank grading engine (api/generate-keywords.js, api/grade-open-ended.js) ---
# See docs/firebase-setup.md for how to obtain these.

# Required for both new endpoints. Base64-encoded contents of a Firebase
# service-account JSON key (Project Settings -> Service Accounts -> Generate
# new private key). Base64-encoding avoids the private-key-newline escaping
# problems that raw multi-line JSON runs into in Vercel's env var UI.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Required for api/generate-keywords.js. Comma-separated list of email
# addresses allowed to (re)generate a keyword bank. Must match the Firebase
# Auth account(s) used to sign in on teacher.html / dashboard.html.
TEACHER_EMAILS=malathi.learning@gmail.com

# Optional — max upload size (bytes) accepted for a syllabus file, enforced in
# api/generate-keywords.js before any extraction/LLM work happens.
MAX_SYLLABUS_UPLOAD_BYTES=5242880
